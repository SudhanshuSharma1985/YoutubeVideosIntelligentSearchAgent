import PyPDF2
import pdfplumber
from collections import defaultdict
import re

def extract_with_pdfplumber(pdf_path):
    """
    Extract text using pdfplumber with font analysis.
    Attempts to identify headings based on font size and style.
    """
    print("\nExtracting text with font-aware analysis...")
    print("=" * 70)
    
    structured_text = []
    
    with pdfplumber.open(pdf_path) as pdf:
        for page_num, page in enumerate(pdf.pages, 1):
            structured_text.append(f"\n{'='*70}\nPage {page_num}\n{'='*70}\n")
            
            # Extract words with their properties
            words = page.extract_words(extra_attrs=['fontname', 'size'])
            
            if not words:
                continue
            
            # Group words by font size to identify potential headings
            font_sizes = [w['size'] for w in words if 'size' in w]
            if not font_sizes:
                structured_text.append(page.extract_text())
                continue
                
            avg_size = sum(font_sizes) / len(font_sizes)
            max_size = max(font_sizes)
            
            # Build lines from words
            current_line = []
            current_top = None
            current_size = None
            
            for word in words:
                word_top = round(word['top'], 1)
                word_size = word.get('size', avg_size)
                
                # Check if this word starts a new line
                if current_top is None or abs(word_top - current_top) > 2:
                    # Process previous line
                    if current_line:
                        line_text = ' '.join(current_line)
                        
                        # Determine if line is a heading based on font size
                        if current_size and current_size > avg_size * 1.2:
                            if current_size >= max_size * 0.95:
                                structured_text.append(f"\n### {line_text} ###\n")
                            elif current_size > avg_size * 1.5:
                                structured_text.append(f"\n## {line_text} ##\n")
                            else:
                                structured_text.append(f"\n# {line_text} #\n")
                        else:
                            structured_text.append(line_text)
                    
                    # Start new line
                    current_line = [word['text']]
                    current_top = word_top
                    current_size = word_size
                else:
                    current_line.append(word['text'])
            
            # Don't forget the last line
            if current_line:
                line_text = ' '.join(current_line)
                if current_size and current_size > avg_size * 1.2:
                    structured_text.append(f"\n# {line_text} #\n")
                else:
                    structured_text.append(line_text)
    
    return '\n'.join(structured_text)


def get_heading_level(line):
    """
    Determine the heading level (1, 2, 3) or 0 if not a heading.
    Level 1: Main sections (###)
    Level 2: Subsections (##)
    Level 3: Sub-subsections (#)
    """
    line = line.strip()
    
    # Check for our heading markers
    if line.startswith('###') and line.endswith('###'):
        return 1
    if line.startswith('##') and line.endswith('##'):
        return 2
    if line.startswith('#') and line.endswith('#'):
        return 3
    
    # Check for numbered sections (1., 2., 3., etc.)
    if re.match(r'^\d+\.\s+[A-Z]', line):
        return 1
    
    # Check for lettered subsections (A., B., C., etc.)
    if re.match(r'^[A-Z]\.\s+[A-Z]', line):
        return 2
    
    # Check for all caps headings
    if line.isupper() and len(line) > 3 and len(line) < 100:
        return 1
    
    return 0


def build_document_tree(text):
    """
    Build a hierarchical tree structure of the document.
    Each node represents a section with its heading and content.
    """
    lines = text.split('\n')
    
    # Root node
    root = {
        'level': 0,
        'heading': 'Document Root',
        'content': [],
        'children': []
    }
    
    # Stack to keep track of the current path in the tree
    stack = [root]
    
    current_node = root
    
    for line in lines:
        level = get_heading_level(line)
        
        if level > 0:
            # Create new section node
            new_node = {
                'level': level,
                'heading': line.strip(),
                'content': [line],
                'children': []
            }
            
            # Find the appropriate parent
            # Pop from stack until we find a parent with lower level
            while len(stack) > 1 and stack[-1]['level'] >= level:
                stack.pop()
            
            parent = stack[-1]
            parent['children'].append(new_node)
            stack.append(new_node)
            current_node = new_node
        else:
            # Add content to current node
            if current_node:
                current_node['content'].append(line)
    
    return root


def flatten_tree_to_subdocuments(node, parent_heading='', subdocs=None):
    """
    Flatten the tree structure into subdocuments.
    Each subdocument includes the full path of headings and all content.
    """
    if subdocs is None:
        subdocs = []
    
    # Build the full heading path
    if node['level'] > 0:
        full_heading = f"{parent_heading} > {node['heading']}" if parent_heading else node['heading']
    else:
        full_heading = parent_heading
    
    # If this node has content (not just children), create a subdocument
    if node['content'] and node['level'] > 0:
        subdoc_content = '\n'.join(node['content'])
        
        subdocs.append({
            'full_heading': full_heading,
            'heading': node['heading'],
            'level': node['level'],
            'content': subdoc_content,
            'size': len(subdoc_content),
            'has_children': len(node['children']) > 0
        })
    
    # Recursively process children
    for child in node['children']:
        flatten_tree_to_subdocuments(child, full_heading, subdocs)
    
    return subdocs


def split_subdocument_if_needed(subdoc, max_chunk_size):
    """
    Split a subdocument into multiple chunks if it exceeds max_chunk_size.
    """
    if subdoc['size'] <= max_chunk_size:
        return [{
            'full_heading': subdoc['full_heading'],
            'heading': subdoc['heading'],
            'level': subdoc['level'],
            'content': subdoc['content'],
            'size': subdoc['size'],
            'part': None
        }]
    
    # Need to split
    chunks = []
    lines = subdoc['content'].split('\n')
    
    current_lines = [lines[0]]  # Start with heading
    current_size = len(lines[0]) + 1
    part_num = 1
    
    for line in lines[1:]:
        line_length = len(line) + 1
        
        if current_size + line_length > max_chunk_size and len(current_lines) > 1:
            chunk_content = '\n'.join(current_lines)
            chunks.append({
                'full_heading': subdoc['full_heading'],
                'heading': subdoc['heading'],
                'level': subdoc['level'],
                'content': chunk_content,
                'size': len(chunk_content),
                'part': part_num
            })
            part_num += 1
            current_lines = [lines[0], line]
            current_size = len(lines[0]) + 1 + line_length
        else:
            current_lines.append(line)
            current_size += line_length
    
    # Add last chunk
    if len(current_lines) > 1:
        chunk_content = '\n'.join(current_lines)
        chunks.append({
            'full_heading': subdoc['full_heading'],
            'heading': subdoc['heading'],
            'level': subdoc['level'],
            'content': chunk_content,
            'size': len(chunk_content),
            'part': part_num
        })
    
    return chunks


def create_subdocument_chunks(text, max_chunk_size=1000):
    """
    Create subdocument chunks with hierarchical structure.
    """
    print(f"\nCreating subdocument chunks (max size: {max_chunk_size} characters)...")
    print("=" * 70)
    
    # Build document tree
    print("Building document tree structure...")
    tree = build_document_tree(text)
    
    # Flatten to subdocuments
    print("Extracting subdocuments...")
    subdocuments = flatten_tree_to_subdocuments(tree)
    print(f"Found {len(subdocuments)} subdocuments")
    
    # Process each subdocument
    all_chunks = []
    chunk_number = 1
    
    for subdoc in subdocuments:
        subdoc_chunks = split_subdocument_if_needed(subdoc, max_chunk_size)
        
        for chunk in subdoc_chunks:
            chunk['chunk_number'] = chunk_number
            all_chunks.append(chunk)
            chunk_number += 1
    
    return all_chunks


def save_chunks(chunks, output_prefix="chunk"):
    """
    Save chunks to individual files and create a master file.
    """
    print(f"\nSaving {len(chunks)} chunks...")
    print("=" * 70)
    
    # Save individual chunk files
    for chunk in chunks:
        filename = f"{output_prefix}_{chunk['chunk_number']:03d}.txt"
        
        # Create display heading
        if chunk['part'] is not None:
            display_heading = f"{chunk['full_heading']} (Part {chunk['part']})"
        else:
            display_heading = chunk['full_heading']
        
        with open(filename, 'w', encoding='utf-8') as f:
            f.write(f"CHUNK {chunk['chunk_number']}\n")
            f.write(f"Heading Path: {display_heading}\n")
            f.write(f"Level: {chunk['level']}\n")
            f.write(f"Size: {chunk['size']} characters\n")
            f.write("=" * 70 + "\n\n")
            f.write(chunk['content'])
        
        # Truncate for display
        display_short = display_heading[:60] + "..." if len(display_heading) > 60 else display_heading
        print(f"✓ Chunk {chunk['chunk_number']:3d}: {display_short} ({chunk['size']} chars)")
    
    # Save master file
    master_filename = f"{output_prefix}_master.txt"
    with open(master_filename, 'w', encoding='utf-8') as f:
        for chunk in chunks:
            display_heading = f"{chunk['full_heading']} (Part {chunk['part']})" if chunk['part'] else chunk['full_heading']
            
            f.write(f"\n{'='*70}\n")
            f.write(f"CHUNK {chunk['chunk_number']} | Level {chunk['level']}\n")
            f.write(f"{display_heading}\n")
            f.write(f"Size: {chunk['size']} characters\n")
            f.write(f"{'='*70}\n\n")
            f.write(chunk['content'])
            f.write("\n\n")
    
    print(f"\n✓ Master file saved: {master_filename}")


def create_chunk_index(chunks, output_file="chunk_index.txt"):
    """
    Create an index showing the hierarchical structure.
    """
    print(f"\nCreating chunk index...")
    
    with open(output_file, 'w', encoding='utf-8') as f:
        f.write("CHUNK INDEX - HIERARCHICAL STRUCTURE\n")
        f.write("=" * 70 + "\n\n")
        f.write(f"Total Chunks: {len(chunks)}\n\n")
        
        for chunk in chunks:
            # Add indentation based on level
            indent = "  " * (chunk['level'] - 1)
            display_heading = f"{chunk['full_heading']} (Part {chunk['part']})" if chunk['part'] else chunk['full_heading']
            
            f.write(f"{indent}Chunk {chunk['chunk_number']:3d} | {chunk['size']:4d} chars | {display_heading}\n")
    
    print(f"✓ Index saved: {output_file}")


def create_tree_visualization(chunks, output_file="tree_structure.txt"):
    """
    Create a visual tree structure of the document.
    """
    print(f"\nCreating tree visualization...")
    
    with open(output_file, 'w', encoding='utf-8') as f:
        f.write("DOCUMENT TREE STRUCTURE\n")
        f.write("=" * 70 + "\n\n")
        
        current_level = 0
        for chunk in chunks:
            level = chunk['level']
            
            # Create tree branch symbols
            if level == 1:
                symbol = "│\n├─"
            elif level == 2:
                symbol = "│  ├─"
            elif level == 3:
                symbol = "│  │  ├─"
            else:
                symbol = "│  " * (level - 1) + "├─"
            
            part_info = f" (Part {chunk['part']})" if chunk['part'] else ""
            f.write(f"{symbol} {chunk['heading']}{part_info} [{chunk['size']} chars]\n")
    
    print(f"✓ Tree visualization saved: {output_file}")


# Example usage
if __name__ == "__main__":
    # Specify your PDF file path
    pdf_file = "2025-CQL-Style-Guide.pdf"
    max_chunk_size = 1000
    
    print("PDF Subdocument Chunking with Hierarchical Structure")
    print("=" * 70)
    print(f"Processing: {pdf_file}")
    print(f"Max chunk size: {max_chunk_size} characters")
    print("Strategy: Hierarchical subdocument chunking\n")
    
    try:
        # Step 1: Extract text with pdfplumber
        extracted_text = extract_with_pdfplumber(pdf_file)
        
        # Save full extracted text
        with open("output_full_extracted.txt", 'w', encoding='utf-8') as f:
            f.write(extracted_text)
        print("✓ Full extraction saved: output_full_extracted.txt")
        
        # Step 2: Create subdocument chunks
        chunks = create_subdocument_chunks(extracted_text, max_chunk_size)
        
        # Step 3: Save chunks
        save_chunks(chunks, output_prefix="subdoc_chunk")
        
        # Step 4: Create index and tree visualization
        create_chunk_index(chunks)
        create_tree_visualization(chunks)
        
        print("\n" + "=" * 70)
        print("Processing complete!")
        print("\nFiles created:")
        print("  1. output_full_extracted.txt - Full extracted text")
        print(f"  2. subdoc_chunk_001.txt to subdoc_chunk_{len(chunks):03d}.txt - Individual chunks")
        print("  3. subdoc_chunk_master.txt - All chunks in one file")
        print("  4. chunk_index.txt - Hierarchical index")
        print("  5. tree_structure.txt - Visual tree structure")
        
    except FileNotFoundError:
        print(f"Error: File '{pdf_file}' not found!")
        print("Please update the 'pdf_file' variable with your PDF path.")
    except Exception as e:
        print(f"Error: {e}")
        import traceback
        traceback.print_exc()


