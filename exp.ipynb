import PyPDF2
import pdfplumber
import re
import numpy as np
from sentence_transformers import SentenceTransformer
from sklearn.metrics.pairwise import cosine_similarity
import pickle
import os

class PDFRAGSystem:
    def __init__(self, pdf_path, max_chunk_size=1000):
        self.pdf_path = pdf_path
        self.max_chunk_size = max_chunk_size
        self.chunks = []
        self.embeddings = None
        self.model = None
        
    def extract_with_pdfplumber(self):
        """Extract text using pdfplumber with font analysis."""
        print("\n📄 Extracting text from PDF...")
        print("=" * 70)
        
        structured_text = []
        
        with pdfplumber.open(self.pdf_path) as pdf:
            for page_num, page in enumerate(pdf.pages, 1):
                words = page.extract_words(extra_attrs=['fontname', 'size'])
                
                if not words:
                    continue
                
                font_sizes = [w['size'] for w in words if 'size' in w]
                if not font_sizes:
                    structured_text.append(page.extract_text())
                    continue
                    
                avg_size = sum(font_sizes) / len(font_sizes)
                max_size = max(font_sizes)
                
                current_line = []
                current_top = None
                current_size = None
                
                for word in words:
                    word_top = round(word['top'], 1)
                    word_size = word.get('size', avg_size)
                    
                    if current_top is None or abs(word_top - current_top) > 2:
                        if current_line:
                            line_text = ' '.join(current_line)
                            
                            if current_size and current_size > avg_size * 1.2:
                                if current_size >= max_size * 0.95:
                                    structured_text.append(f"\n### {line_text} ###\n")
                                elif current_size > avg_size * 1.5:
                                    structured_text.append(f"\n## {line_text} ##\n")
                                else:
                                    structured_text.append(f"\n# {line_text} #\n")
                            else:
                                structured_text.append(line_text)
                        
                        current_line = [word['text']]
                        current_top = word_top
                        current_size = word_size
                    else:
                        current_line.append(word['text'])
                
                if current_line:
                    line_text = ' '.join(current_line)
                    if current_size and current_size > avg_size * 1.2:
                        structured_text.append(f"\n# {line_text} #\n")
                    else:
                        structured_text.append(line_text)
        
        return '\n'.join(structured_text)

    def get_heading_level(self, line):
        """Determine the heading level."""
        line = line.strip()
        
        if line.startswith('###') and line.endswith('###'):
            return 1
        if line.startswith('##') and line.endswith('##'):
            return 2
        if line.startswith('#') and line.endswith('#'):
            return 3
        if re.match(r'^\d+\.\s+[A-Z]', line):
            return 1
        if re.match(r'^[A-Z]\.\s+[A-Z]', line):
            return 2
        if line.isupper() and len(line) > 3 and len(line) < 100:
            return 1
        
        return 0

    def build_document_tree(self, text):
        """Build a hierarchical tree structure."""
        lines = text.split('\n')
        
        root = {
            'level': 0,
            'heading': 'Document Root',
            'content': [],
            'children': []
        }
        
        stack = [root]
        current_node = root
        
        for line in lines:
            level = self.get_heading_level(line)
            
            if level > 0:
                new_node = {
                    'level': level,
                    'heading': line.strip(),
                    'content': [line],
                    'children': []
                }
                
                while len(stack) > 1 and stack[-1]['level'] >= level:
                    stack.pop()
                
                parent = stack[-1]
                parent['children'].append(new_node)
                stack.append(new_node)
                current_node = new_node
            else:
                if current_node:
                    current_node['content'].append(line)
        
        return root

    def flatten_tree_to_subdocuments(self, node, parent_heading='', subdocs=None):
        """Flatten tree to subdocuments."""
        if subdocs is None:
            subdocs = []
        
        if node['level'] > 0:
            full_heading = f"{parent_heading} > {node['heading']}" if parent_heading else node['heading']
        else:
            full_heading = parent_heading
        
        if node['content'] and node['level'] > 0:
            subdoc_content = '\n'.join(node['content'])
            
            subdocs.append({
                'full_heading': full_heading,
                'heading': node['heading'],
                'level': node['level'],
                'content': subdoc_content,
                'size': len(subdoc_content)
            })
        
        for child in node['children']:
            self.flatten_tree_to_subdocuments(child, full_heading, subdocs)
        
        return subdocs

    def split_subdocument_if_needed(self, subdoc):
        """Split subdocument if it exceeds max size."""
        if subdoc['size'] <= self.max_chunk_size:
            return [{
                'full_heading': subdoc['full_heading'],
                'heading': subdoc['heading'],
                'level': subdoc['level'],
                'content': subdoc['content'],
                'size': subdoc['size'],
                'part': None
            }]
        
        chunks = []
        lines = subdoc['content'].split('\n')
        
        current_lines = [lines[0]]
        current_size = len(lines[0]) + 1
        part_num = 1
        
        for line in lines[1:]:
            line_length = len(line) + 1
            
            if current_size + line_length > self.max_chunk_size and len(current_lines) > 1:
                chunk_content = '\n'.join(current_lines)
                chunks.append({
                    'full_heading': subdoc['full_heading'],
                    'heading': subdoc['heading'],
                    'level': subdoc['level'],
                    'content': chunk_content,
                    'size': len(chunk_content),
                    'part': part_num
                })
                part_num += 1
                current_lines = [lines[0], line]
                current_size = len(lines[0]) + 1 + line_length
            else:
                current_lines.append(line)
                current_size += line_length
        
        if len(current_lines) > 1:
            chunk_content = '\n'.join(current_lines)
            chunks.append({
                'full_heading': subdoc['full_heading'],
                'heading': subdoc['heading'],
                'level': subdoc['level'],
                'content': chunk_content,
                'size': len(chunk_content),
                'part': part_num
            })
        
        return chunks

    def create_chunks(self):
        """Create subdocument chunks."""
        print("\n🔨 Creating subdocument chunks...")
        print("=" * 70)
        
        text = self.extract_with_pdfplumber()
        tree = self.build_document_tree(text)
        subdocuments = self.flatten_tree_to_subdocuments(tree)
        
        print(f"✓ Found {len(subdocuments)} subdocuments")
        
        all_chunks = []
        chunk_number = 1
        
        for subdoc in subdocuments:
            subdoc_chunks = self.split_subdocument_if_needed(subdoc)
            
            for chunk in subdoc_chunks:
                chunk['chunk_number'] = chunk_number
                all_chunks.append(chunk)
                chunk_number += 1
        
        self.chunks = all_chunks
        print(f"✓ Created {len(all_chunks)} chunks")
        return all_chunks

    def load_embedding_model(self):
        """Load sentence transformer model for embeddings."""
        print("\n🤖 Loading embedding model...")
        print("=" * 70)
        print("Using: all-MiniLM-L6-v2 (lightweight and fast)")
        
        self.model = SentenceTransformer('all-MiniLM-L6-v2')
        print("✓ Model loaded successfully")

    def create_embeddings(self):
        """Create embeddings for all chunks."""
        if not self.chunks:
            raise ValueError("No chunks available. Run create_chunks() first.")
        
        if self.model is None:
            self.load_embedding_model()
        
        print("\n🔢 Creating embeddings for all chunks...")
        print("=" * 70)
        
        # Create text for embedding (heading + content)
        texts = [f"{chunk['full_heading']}\n{chunk['content']}" for chunk in self.chunks]
        
        self.embeddings = self.model.encode(texts, show_progress_bar=True)
        print(f"✓ Created embeddings: {self.embeddings.shape}")

    def save_index(self, filename='rag_index.pkl'):
        """Save chunks and embeddings to disk."""
        print(f"\n💾 Saving RAG index to {filename}...")
        
        data = {
            'chunks': self.chunks,
            'embeddings': self.embeddings,
            'pdf_path': self.pdf_path,
            'max_chunk_size': self.max_chunk_size
        }
        
        with open(filename, 'wb') as f:
            pickle.dump(data, f)
        
        print("✓ Index saved successfully")

    def load_index(self, filename='rag_index.pkl'):
        """Load chunks and embeddings from disk."""
        print(f"\n📂 Loading RAG index from {filename}...")
        
        if not os.path.exists(filename):
            raise FileNotFoundError(f"Index file {filename} not found. Create it first.")
        
        with open(filename, 'rb') as f:
            data = pickle.load(f)
        
        self.chunks = data['chunks']
        self.embeddings = data['embeddings']
        self.pdf_path = data['pdf_path']
        self.max_chunk_size = data['max_chunk_size']
        
        if self.model is None:
            self.load_embedding_model()
        
        print(f"✓ Loaded {len(self.chunks)} chunks with embeddings")

    def retrieve_relevant_chunks(self, query, top_k=3):
        """Retrieve most relevant chunks for a query."""
        if self.embeddings is None:
            raise ValueError("No embeddings available. Run create_embeddings() first.")
        
        # Encode query
        query_embedding = self.model.encode([query])
        
        # Calculate similarity
        similarities = cosine_similarity(query_embedding, self.embeddings)[0]
        
        # Get top-k indices
        top_indices = np.argsort(similarities)[-top_k:][::-1]
        
        # Return relevant chunks with scores
        results = []
        for idx in top_indices:
            results.append({
                'chunk': self.chunks[idx],
                'similarity_score': float(similarities[idx])
            })
        
        return results

    def format_context(self, retrieved_chunks):
        """Format retrieved chunks into context for LLM."""
        context_parts = []
        
        for i, item in enumerate(retrieved_chunks, 1):
            chunk = item['chunk']
            score = item['similarity_score']
            
            part_info = f" (Part {chunk['part']})" if chunk['part'] else ""
            
            context_parts.append(
                f"--- Source {i} (Relevance: {score:.2%}) ---\n"
                f"Section: {chunk['full_heading']}{part_info}\n"
                f"Content:\n{chunk['content']}\n"
            )
        
        return "\n".join(context_parts)

    def query(self, question, top_k=3):
        """Main query method - retrieve and display results."""
        print(f"\n🔍 Query: {question}")
        print("=" * 70)
        
        # Retrieve relevant chunks
        results = self.retrieve_relevant_chunks(question, top_k)
        
        # Format context
        context = self.format_context(results)
        
        print("\n📚 Retrieved Context:")
        print("=" * 70)
        print(context)
        
        return {
            'question': question,
            'retrieved_chunks': results,
            'context': context
        }


# Main execution
if __name__ == "__main__":
    pdf_file = "2025-CQL-Style-Guide.pdf"
    
    print("🚀 PDF RAG System - Retrieval Augmented Generation")
    print("=" * 70)
    
    # Initialize RAG system
    rag = PDFRAGSystem(pdf_file, max_chunk_size=1000)
    
    # Check if index exists
    index_file = 'rag_index.pkl'
    
    if os.path.exists(index_file):
        print(f"\n✓ Found existing index: {index_file}")
        user_input = input("Load existing index? (y/n): ").lower()
        
        if user_input == 'y':
            rag.load_index(index_file)
        else:
            print("\n🔄 Creating new index...")
            rag.create_chunks()
            rag.create_embeddings()
            rag.save_index(index_file)
    else:
        print("\n📊 No existing index found. Creating new one...")
        rag.create_chunks()
        rag.create_embeddings()
        rag.save_index(index_file)
    
    # Interactive query loop
    print("\n" + "=" * 70)
    print("✅ RAG System Ready!")
    print("=" * 70)
    print("\nYou can now ask questions about the PDF.")
    print("Type 'quit' or 'exit' to stop.\n")
    
    while True:
        question = input("\n💬 Your Question: ").strip()
        
        if question.lower() in ['quit', 'exit', 'q']:
            print("\n👋 Goodbye!")
            break
        
        if not question:
            continue
        
        try:
            result = rag.query(question, top_k=3)
            
            print("\n💡 To use this context with an LLM:")
            print("Copy the 'Retrieved Context' above and paste it into your prompt")
            print("along with your question to get AI-generated answers.")
            
        except Exception as e:
            print(f"\n❌ Error: {e}")
            import traceback
            traceback.print_exc()

